# Copy to .env (which git ignores) and fill in. Docker Compose reads it automatically.

# Job-alert emails from Gmail: a Google OAuth client, see docs/gmail-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_LABEL=Job alerts

# Claude, for match scores and drafted messages: an API key from console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# New roles scored automatically after each daily sync (each is one API call)
AI_DAILY_LIMIT=30

# Time zone for the 07:00 daily sync
TZ=America/Chicago
